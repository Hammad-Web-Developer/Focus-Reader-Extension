{
    "manifest_version": 3,
    "name": "Focus Reader",
    "version": "1.0",
    "description": "blur sorrundings,speed control,auto scroll,word definition,events context,reading goals,revision notes",

    "permissions":["tabs"],

    "action":{
        "default_popup": "popup.html",
        "default_title":"Focus Reader",
        "default_icon":{
         "16":"icons/16.png",
         "32":"icons/32.png",
         "48":"icons/48.png",
         "64":"icons/64.png",
         "128":"icons/128.png"
        }
    }


}